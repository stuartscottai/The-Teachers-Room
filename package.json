    "privacy:verify:live": "node scripts/verify-live-quiz-privacy.mjs",
    "test:e2e": "playwright test",
    "test:e2e:prod-smoke": "playwright test -c playwright.prod-smoke.config.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug"
  },
  "dependencies": {
    "@google/genai": "^1.30.0",
