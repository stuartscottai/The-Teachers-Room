    "@tiptap/starter-kit": "^3.13.0",
    "dompurify": "^3.4.2",
    "framer-motion": "^12.23.26",
    "interactjs": "^1.10.27",
    "jsonrepair": "^3.14.0",
    "lucide-react": "0.300.0",
    "maath": "0.10.8",
