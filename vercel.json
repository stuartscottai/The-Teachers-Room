{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/share/game/:id", "destination": "/api/share-preview?kind=teacher&id=:id" },
    { "source": "/student/game/:id", "destination": "/api/share-preview?kind=student&id=:id" },
    { "source": "/student/share/:id", "destination": "/api/share-preview?kind=student-share&id=:id" },
    { "source": "/(.*)", "destination": "/noindex.html" }
  ],
  "functions": {
    "api/share-preview.ts": {
      "includeFiles": "{dist/teacher-game.html,dist/student-game.html,public/assets/share-logo.png}"
    }
  },
  "headers": [
    {
      "source": "/class/:path*",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Embedder-Policy", "value": "require-corp" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), geolocation=()" }
      ]
    },
    {
      "source": "/:privatePage(profile|reset-password|choose-plan|change-plan|school-admin)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/:privateSection(live|test|student)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/:privateSection(live|test|student)/:path*",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/share/game/:path*",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ]
}
